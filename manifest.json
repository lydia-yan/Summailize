{
  "manifest_version": 3,
  "name": "AIMAIL - Gmail Summary Assistant",
  "version": "1.0.0",
  "description": "Provides intelligent summaries for your Gmail messages to help you process emails more efficiently",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "action": {
    "default_title": "Open Summary Assistant",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://mail.google.com/*"],
      "js": ["contentScript.js"],
      "css": ["contentStyle.css"]
    }
  ],
  "host_permissions": [
    "*://mail.google.com/*"
  ],
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "identity",
    "identity.email"
  ],
  "web_accessible_resources": [
    {
      "resources": ["index.html", "main.js", "iframe-messaging.js"],
      "matches": ["*://mail.google.com/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
} 